<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="120dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/noto_sans_kr_regular"
                android:includeFontPadding="false"
                android:text="교환일시 모아보기"
                android:textColor="@color/text_primary"
                android:textSize="23sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/date_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/noto_sans_kr_regular"
                android:includeFontPadding="false"
                android:textColor="@color/main_2"
                android:textSize="20sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/title_tv"
                tools:text="2025년 10월 22일" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/exchange_rv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="true"
                android:overScrollMode="never"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/date_tv"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="2"
                tools:listitem="@layout/item_record_exchange_info" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/common_info_cv"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginHorizontal="10dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="40dp"
                android:backgroundTint="@color/edit_card"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/exchange_rv"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/weight_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="20dp"
                        android:fontFamily="@font/noto_sans_kr_regular"
                        android:includeFontPadding="false"
                        android:text="체중"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <EditText
                        android:id="@+id/weight_data_et"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:background="@color/transparent"
                        android:fontFamily="@font/noto_sans_kr_medium"
                        android:includeFontPadding="false"
                        android:hint="56"
                        android:inputType="numberDecimal"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        app:layout_constraintTop_toTopOf="@id/weight_tv"
                        app:layout_constraintEnd_toStartOf="@id/weight_unit_tv"/>

                    <TextView
                        android:id="@+id/weight_unit_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="20dp"
                        android:fontFamily="@font/noto_sans_kr_regular"
                        android:includeFontPadding="false"
                        android:text="kg"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/weight_tv" />

                    <TextView
                        android:id="@+id/blood_pressure_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/noto_sans_kr_regular"
                        android:includeFontPadding="false"
                        android:text="혈압"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="@id/weight_tv"
                        app:layout_constraintTop_toBottomOf="@id/weight_tv" />

                    <EditText
                        android:id="@+id/systolic_et"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:background="@color/transparent"
                        android:fontFamily="@font/noto_sans_kr_medium"
                        android:includeFontPadding="false"
                        android:hint="150"
                        android:inputType="number"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        app:layout_constraintTop_toTopOf="@id/blood_pressure_tv"
                        app:layout_constraintEnd_toStartOf="@id/blood_pressure_divider"/>

                    <TextView
                        android:id="@+id/blood_pressure_divider"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:fontFamily="@font/noto_sans_kr_regular"
                        android:includeFontPadding="false"
                        android:text="/"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/diastolic_et"
                        app:layout_constraintTop_toTopOf="@id/blood_pressure_tv" />

                    <EditText
                        android:id="@+id/diastolic_et"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:background="@color/transparent"
                        android:fontFamily="@font/noto_sans_kr_medium"
                        android:includeFontPadding="false"
                        android:hint="90"
                        android:inputType="number"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        app:layout_constraintTop_toTopOf="@id/blood_pressure_tv"
                        app:layout_constraintEnd_toStartOf="@id/blood_pressure_unit_tv"/>

                    <TextView
                        android:id="@+id/blood_pressure_unit_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="20dp"
                        android:fontFamily="@font/noto_sans_kr_regular"
                        android:includeFontPadding="false"
                        android:text="mmHg"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/blood_pressure_tv" />

                    <TextView
                        android:id="@+id/fasting_glucose_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/noto_sans_kr_regular"
                        android:includeFontPadding="false"
                        android:text="공복 혈당"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="@id/blood_pressure_tv"
                        app:layout_constraintTop_toBottomOf="@id/blood_pressure_tv" />

                    <EditText
                        android:id="@+id/fasting_glucose_et"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:background="@color/transparent"
                        android:fontFamily="@font/noto_sans_kr_medium"
                        android:includeFontPadding="false"
                        android:hint="134"
                        android:inputType="number"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        app:layout_constraintTop_toTopOf="@id/fasting_glucose_tv"
                        app:layout_constraintEnd_toStartOf="@id/fasting_glucose_unit_tv"/>

                    <TextView
                        android:id="@+id/fasting_glucose_unit_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="20dp"
                        android:fontFamily="@font/noto_sans_kr_regular"
                        android:includeFontPadding="false"
                        android:text="mg/dL"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/fasting_glucose_tv" />

                    <TextView
                        android:id="@+id/urine_count_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/noto_sans_kr_regular"
                        android:includeFontPadding="false"
                        android:text="소변 횟수"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="@id/fasting_glucose_tv"
                        app:layout_constraintTop_toBottomOf="@id/fasting_glucose_tv" />

                    <EditText
                        android:id="@+id/urine_count_et"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:background="@color/transparent"
                        android:fontFamily="@font/noto_sans_kr_medium"
                        android:includeFontPadding="false"
                        android:hint="4"
                        android:inputType="number"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        app:layout_constraintTop_toTopOf="@id/urine_count_tv"
                        app:layout_constraintEnd_toStartOf="@id/urine_count_unit_tv"/>

                    <TextView
                        android:id="@+id/urine_count_unit_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="20dp"
                        android:fontFamily="@font/noto_sans_kr_regular"
                        android:includeFontPadding="false"
                        android:text="회"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/urine_count_tv" />

                    <TextView
                        android:id="@+id/turbidity_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/noto_sans_kr_regular"
                        android:includeFontPadding="false"
                        android:text="혼탁도"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="@id/urine_count_tv"
                        app:layout_constraintTop_toBottomOf="@id/urine_count_tv" />

                    <androidx.appcompat.widget.AppCompatCheckBox
                        android:id="@+id/turbidity_n_checkbox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-3dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        app:layout_constraintEnd_toStartOf="@id/turbidity_n_tv"
                        app:layout_constraintTop_toTopOf="@id/turbidity_tv" />

                    <TextView
                        android:id="@+id/turbidity_n_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:fontFamily="@font/noto_sans_kr_regular"
                        android:includeFontPadding="false"
                        android:text="없음"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        app:layout_constraintEnd_toStartOf="@id/turbidity_y_checkbox"
                        app:layout_constraintTop_toTopOf="@id/turbidity_tv" />

                    <androidx.appcompat.widget.AppCompatCheckBox
                        android:id="@+id/turbidity_y_checkbox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="-3dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        app:layout_constraintEnd_toStartOf="@id/turbidity_y_tv"
                        app:layout_constraintTop_toTopOf="@id/turbidity_tv" />

                    <TextView
                        android:id="@+id/turbidity_y_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="20dp"
                        android:fontFamily="@font/noto_sans_kr_regular"
                        android:includeFontPadding="false"
                        android:text="있음"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/turbidity_tv" />

                    <TextView
                        android:id="@+id/total_uf_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/noto_sans_kr_regular"
                        android:includeFontPadding="false"
                        android:text="제수량 합계"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="@id/turbidity_tv"
                        app:layout_constraintTop_toBottomOf="@id/turbidity_tv" />

                    <EditText
                        android:id="@+id/total_uf_et"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:background="@color/transparent"
                        android:fontFamily="@font/noto_sans_kr_medium"
                        android:includeFontPadding="false"
                        android:hint="600"
                        android:inputType="number"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        app:layout_constraintTop_toTopOf="@id/total_uf_tv"
                        app:layout_constraintEnd_toStartOf="@id/total_uf_unit_tv"/>

                    <TextView
                        android:id="@+id/total_uf_unit_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="20dp"
                        android:fontFamily="@font/noto_sans_kr_regular"
                        android:includeFontPadding="false"
                        android:text="g"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/total_uf_tv" />

                    <TextView
                        android:id="@+id/notes_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/noto_sans_kr_regular"
                        android:includeFontPadding="false"
                        android:text="비고"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="@id/total_uf_tv"
                        app:layout_constraintTop_toBottomOf="@id/total_uf_tv" />

                    <EditText
                        android:id="@+id/notes_et"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:background="@color/transparent"
                        android:fontFamily="@font/noto_sans_kr_medium"
                        android:includeFontPadding="false"
                        android:hint="추가 정보를 입력하세요"
                        android:maxLines="4"
                        android:overScrollMode="ifContentScrolls"
                        android:scrollbars="vertical"
                        android:inputType="textMultiLine"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        app:layout_constraintTop_toTopOf="@id/notes_tv"
                        app:layout_constraintStart_toEndOf="@id/total_uf_tv"/>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
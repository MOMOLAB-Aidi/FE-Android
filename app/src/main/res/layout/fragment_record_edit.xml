<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_bg"
    tools:context=".ui.record.RecordEditFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="40dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/title_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_gradient"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/title_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/noto_sans_kr_medium"
                    android:includeFontPadding="false"
                    android:text="기록 상세"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/content_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:fontFamily="@font/noto_sans_kr_regular"
                    android:includeFontPadding="false"
                    android:text="2025년 11월 14일 금"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@id/title_tv"
                    app:layout_constraintTop_toBottomOf="@id/title_tv" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/common_info_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/title_container">

                <View
                    android:id="@+id/section_indicator_common"
                    android:layout_width="4dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="20dp"
                    android:background="@color/main_1"
                    app:layout_constraintBottom_toBottomOf="@id/common_info_title_tv"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/common_info_title_tv" />

                <TextView
                    android:id="@+id/common_info_title_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/noto_sans_kr_medium"
                    android:includeFontPadding="false"
                    android:text="공통 정보"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    app:layout_constraintStart_toEndOf="@id/section_indicator_common"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/common_info_cv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="20dp"
                    android:backgroundTint="@color/white"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/common_info_title_tv"
                    app:strokeWidth="0dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/weight_label_tv"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/noto_sans_kr_regular"
                            android:includeFontPadding="false"
                            android:text="체중 (kg)"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            app:layout_constraintEnd_toStartOf="@id/blood_pressure_label_tv"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <EditText
                            android:id="@+id/weight_value_et"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginEnd="10dp"
                            android:background="#F9F9FA"
                            android:fontFamily="@font/noto_sans_kr_regular"
                            android:gravity="center_vertical"
                            android:hint="56.2"
                            android:includeFontPadding="false"
                            android:inputType="numberDecimal"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:textColor="@color/secondary_text"
                            android:textSize="14sp"
                            app:layout_constraintEnd_toStartOf="@id/blood_pressure_systolic_et"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/weight_label_tv" />

                        <TextView
                            android:id="@+id/blood_pressure_label_tv"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:fontFamily="@font/noto_sans_kr_regular"
                            android:includeFontPadding="false"
                            android:text="혈압 (mmHg)"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/weight_label_tv"
                            app:layout_constraintTop_toTopOf="parent" />

                        <EditText
                            android:id="@+id/blood_pressure_systolic_et"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="5dp"
                            android:background="#F9F9FA"
                            android:fontFamily="@font/noto_sans_kr_regular"
                            android:gravity="center_vertical"
                            android:hint="125"
                            android:includeFontPadding="false"
                            android:inputType="number"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:textColor="@color/secondary_text"
                            android:textSize="14sp"
                            app:layout_constraintEnd_toStartOf="@id/blood_pressure_divider_tv"
                            app:layout_constraintStart_toEndOf="@id/weight_value_et"
                            app:layout_constraintTop_toTopOf="@id/weight_value_et" />

                        <TextView
                            android:id="@+id/blood_pressure_divider_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/noto_sans_kr_regular"
                            android:includeFontPadding="false"
                            android:text="/"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            app:layout_constraintBottom_toBottomOf="@id/blood_pressure_systolic_et"
                            app:layout_constraintEnd_toStartOf="@id/blood_pressure_diastolic_et"
                            app:layout_constraintStart_toEndOf="@id/blood_pressure_systolic_et"
                            app:layout_constraintTop_toTopOf="@id/blood_pressure_systolic_et" />

                        <EditText
                            android:id="@+id/blood_pressure_diastolic_et"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="5dp"
                            android:background="#F9F9FA"
                            android:fontFamily="@font/noto_sans_kr_regular"
                            android:gravity="center_vertical"
                            android:hint="78"
                            android:includeFontPadding="false"
                            android:inputType="number"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:textColor="@color/secondary_text"
                            android:textSize="14sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/blood_pressure_divider_tv"
                            app:layout_constraintTop_toTopOf="@id/weight_value_et" />

                        <TextView
                            android:id="@+id/fasting_glucose_label_tv"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:fontFamily="@font/noto_sans_kr_regular"
                            android:includeFontPadding="false"
                            android:text="공복혈당 (mg/dL)"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            app:layout_constraintEnd_toStartOf="@id/urine_count_label_tv"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/weight_value_et" />

                        <EditText
                            android:id="@+id/fasting_glucose_value_et"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginEnd="10dp"
                            android:background="#F9F9FA"
                            android:fontFamily="@font/noto_sans_kr_regular"
                            android:gravity="center_vertical"
                            android:hint="134"
                            android:includeFontPadding="false"
                            android:inputType="number"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:textColor="@color/secondary_text"
                            android:textSize="14sp"
                            app:layout_constraintEnd_toStartOf="@id/urine_count_value_et"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/fasting_glucose_label_tv" />

                        <TextView
                            android:id="@+id/urine_count_label_tv"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:fontFamily="@font/noto_sans_kr_regular"
                            android:includeFontPadding="false"
                            android:text="소변 횟수 (회)"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/fasting_glucose_label_tv"
                            app:layout_constraintTop_toTopOf="@id/fasting_glucose_label_tv" />

                        <EditText
                            android:id="@+id/urine_count_value_et"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="10dp"
                            android:background="#F9F9FA"
                            android:fontFamily="@font/noto_sans_kr_regular"
                            android:gravity="center_vertical"
                            android:hint="4"
                            android:includeFontPadding="false"
                            android:inputType="number"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:textColor="@color/secondary_text"
                            android:textSize="14sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/fasting_glucose_value_et"
                            app:layout_constraintTop_toTopOf="@id/fasting_glucose_value_et" />

                        <TextView
                            android:id="@+id/turbidity_label_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:fontFamily="@font/noto_sans_kr_regular"
                            android:includeFontPadding="false"
                            android:text="복막액 혼탁"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/urine_count_value_et" />

                        <androidx.appcompat.widget.AppCompatCheckBox
                            android:id="@+id/turbidity_n_checkbox"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            app:layout_constraintStart_toStartOf="@id/turbidity_label_tv"
                            app:layout_constraintTop_toBottomOf="@id/turbidity_label_tv" />

                        <TextView
                            android:id="@+id/turbidity_n_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:fontFamily="@font/noto_sans_kr_regular"
                            android:includeFontPadding="false"
                            android:text="없음"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            app:layout_constraintStart_toEndOf="@id/turbidity_n_checkbox"
                            app:layout_constraintTop_toTopOf="@id/turbidity_n_checkbox" />

                        <androidx.appcompat.widget.AppCompatCheckBox
                            android:id="@+id/turbidity_y_checkbox"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            app:layout_constraintStart_toEndOf="@id/turbidity_n_tv"
                            app:layout_constraintTop_toTopOf="@id/turbidity_n_checkbox" />

                        <TextView
                            android:id="@+id/turbidity_y_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:fontFamily="@font/noto_sans_kr_regular"
                            android:includeFontPadding="false"
                            android:text="있음"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            app:layout_constraintStart_toEndOf="@id/turbidity_y_checkbox"
                            app:layout_constraintTop_toTopOf="@id/turbidity_y_checkbox" />

                        <TextView
                            android:id="@+id/total_uf_label_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:fontFamily="@font/noto_sans_kr_regular"
                            android:includeFontPadding="false"
                            android:text="제수량 합계 (g)"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/turbidity_y_tv" />

                        <EditText
                            android:id="@+id/total_uf_value_et"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            android:background="#F9F9FA"
                            android:fontFamily="@font/noto_sans_kr_regular"
                            android:gravity="center_vertical"
                            android:hint="600"
                            android:includeFontPadding="false"
                            android:inputType="numberSigned"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:textColor="@color/secondary_text"
                            android:textSize="14sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/total_uf_label_tv" />

                        <TextView
                            android:id="@+id/note_label_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:fontFamily="@font/noto_sans_kr_regular"
                            android:includeFontPadding="false"
                            android:text="비고"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/total_uf_value_et" />

                        <EditText
                            android:id="@+id/note_value_et"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="#F9F9FA"
                            android:fontFamily="@font/noto_sans_kr_regular"
                            android:gravity="start|top"
                            android:hint="특이사항 없음"
                            android:includeFontPadding="false"
                            android:inputType="textMultiLine"
                            android:maxLines="4"
                            android:minHeight="80dp"
                            android:overScrollMode="ifContentScrolls"
                            android:padding="16dp"
                            android:scrollbars="vertical"
                            android:textColor="@color/secondary_text"
                            android:textSize="14sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/note_label_tv" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/exchange_info_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/common_info_section"
                app:layout_constraintBottom_toTopOf="@id/bottom_bar">

                <View
                    android:id="@+id/section_indicator_exchange"
                    android:layout_width="4dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="20dp"
                    android:background="#00C951"
                    app:layout_constraintBottom_toBottomOf="@id/exchange_info_title_tv"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/exchange_info_title_tv" />

                <TextView
                    android:id="@+id/exchange_info_title_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/noto_sans_kr_medium"
                    android:includeFontPadding="false"
                    android:text="회차별 정보"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    app:layout_constraintStart_toEndOf="@id/section_indicator_exchange"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:id="@+id/exchange_edit_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    app:layout_constraintTop_toBottomOf="@id/exchange_info_title_tv"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/bottom_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="19dp"
                android:layout_marginEnd="19dp"
                android:orientation="horizontal"
                android:weightSum="2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/exchange_info_section">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cancel_btn"
                    android:layout_width="0dp"
                    android:layout_height="65dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="취소"
                    android:textColor="@color/text_primary"
                    app:backgroundTint="@color/white"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/save_btn"
                    android:layout_width="0dp"
                    android:layout_height="65dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="저장"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/main_1"
                    app:cornerRadius="12dp" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="360dp"
    android:background="@drawable/calendar_background"
    tools:context=".ui.record.BottomSheetSelectMethodFragment">

    <View
        android:id="@+id/handler_v"
        android:layout_width="54dp"
        android:layout_height="4dp"
        android:layout_marginTop="12dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_bottom_sheet_handle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:text="사진 소스를 선택하세요"
        android:fontFamily="@font/noto_sans_kr_medium"
        android:textSize="20sp"
        android:includeFontPadding="false"
        app:layout_constraintTop_toBottomOf="@id/handler_v"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/camera_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:layout_marginStart="19dp"
        android:layout_marginEnd="19dp"
        android:fontFamily="@font/noto_sans_kr_medium"
        android:text="카메라로 촬영"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:backgroundTint="#5989F3"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/album_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginStart="19dp"
        android:layout_marginEnd="19dp"
        android:layout_marginBottom="5dp"
        android:fontFamily="@font/noto_sans_kr_medium"
        android:text="앨범에서 선택"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:backgroundTint="#2859C5"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/camera_btn"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
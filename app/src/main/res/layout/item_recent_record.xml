<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    android:layout_marginVertical="6dp"
    android:layout_marginHorizontal="2dp"
    android:background="@color/white"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="@color/white">

        <ImageView
            android:id="@+id/clock_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_clock_sv"
            android:layout_marginStart="30dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/date_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="15dp"
            android:text="2025.11.14"
            android:textSize="15sp"
            android:fontFamily="@font/noto_sans_kr_medium"
            android:textColor="@color/secondary_text"
            android:textStyle="bold"
            android:includeFontPadding="false"
            app:layout_constraintStart_toEndOf="@id/clock_iv"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/complete_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="4회차 완료"
            android:textSize="15sp"
            android:textColor="@color/secondary_text"
            android:fontFamily="@font/noto_sans_kr_regular"
            android:includeFontPadding="false"
            app:layout_constraintTop_toBottomOf="@id/date_tv"
            app:layout_constraintStart_toStartOf="@id/date_tv"/>

        <TextView
            android:id="@+id/weight_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:text="56.2kg"
            android:fontFamily="@font/noto_sans_kr_regular"
            android:textSize="14sp"
            android:textColor="@color/secondary_text"
            android:includeFontPadding="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/date_tv"/>

        <TextView
            android:id="@+id/total_uf_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="520g"
            android:fontFamily="@font/noto_sans_kr_regular"
            android:textSize="14sp"
            android:textColor="@color/main_text"
            android:includeFontPadding="false"
            app:layout_constraintEnd_toEndOf="@id/weight_tv"
            app:layout_constraintTop_toTopOf="@id/complete_tv"/>



    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
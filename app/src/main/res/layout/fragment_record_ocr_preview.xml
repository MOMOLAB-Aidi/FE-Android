<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/text_primary"
    tools:context=".ui.record.RecordOcrPreviewFragment">

    <ImageView
        android:id="@+id/close_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:layout_marginStart="20dp"
        android:src="@drawable/ic_close_sv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="미리보기"
        android:textColor="@color/white"
        android:textSize="17sp"
        android:fontFamily="@font/noto_sans_kr_regular"
        android:includeFontPadding="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/close_iv" />

    <ImageView
        android:id="@+id/preview_iv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:scaleType="centerInside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/close_iv"
        app:layout_constraintBottom_toTopOf="@id/retake_btn" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/retake_btn"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="60dp"
        android:text="다시 찍기"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:fontFamily="@font/noto_sans_kr_regular"
        android:backgroundTint="@color/white"
        app:cornerRadius="10dp"
        app:icon="@drawable/ic_refresh_sv"
        app:iconGravity="textStart"
        app:iconTint="@color/text_primary"
        app:iconPadding="8dp"
        android:padding="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/use_btn"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/use_btn"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="60dp"
        android:text="사용하기"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:fontFamily="@font/noto_sans_kr_regular"
        android:backgroundTint="@color/main_1"
        app:cornerRadius="10dp"
        app:icon="@drawable/ic_check_sv"
        app:iconGravity="textStart"
        app:iconTint="@color/white"
        app:iconPadding="8dp"
        android:padding="0dp"
        app:layout_constraintStart_toEndOf="@id/retake_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
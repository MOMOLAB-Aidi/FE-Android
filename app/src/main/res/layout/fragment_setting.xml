<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_bg"
    tools:context=".ui.setting.SettingFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="70dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/title_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_gradient"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/title_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/noto_sans_kr_medium"
                    android:includeFontPadding="false"
                    android:text="환경설정"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/content_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:fontFamily="@font/noto_sans_kr_regular"
                    android:includeFontPadding="false"
                    android:text="계정 &amp; 고객센터 &amp; 앱 정보"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@id/title_tv"
                    app:layout_constraintTop_toBottomOf="@id/title_tv" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/patient_info_cv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="20dp"
                android:backgroundTint="@color/white"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/title_container"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white">

                    <ImageView
                        android:id="@+id/people_iv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginStart="15dp"
                        android:src="@drawable/ic_people_sv"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <TextView
                        android:id="@+id/patient_info_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="환자 정보"
                        android:textSize="16sp"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/noto_sans_kr_medium"
                        app:layout_constraintStart_toEndOf="@id/people_iv"
                        app:layout_constraintTop_toTopOf="@id/people_iv"/>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/id_cv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="10dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="40dp"
                        android:layout_marginEnd="20dp"
                        android:backgroundTint="@color/white"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="0dp"
                        app:layout_constraintTop_toBottomOf="@id/patient_info_tv"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:strokeWidth="0dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="#C7DFFF">

                            <ImageView
                                android:id="@+id/profile_iv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:layout_marginStart="15dp"
                                android:src="@drawable/ic_profile_sv"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintStart_toStartOf="parent"/>

                            <TextView
                                android:id="@+id/login_id_title_tv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="15dp"
                                android:fontFamily="@font/noto_sans_kr_regular"
                                android:text="환자 ID"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:includeFontPadding="false"
                                app:layout_constraintStart_toEndOf="@id/profile_iv"
                                app:layout_constraintTop_toTopOf="@id/profile_iv" />

                            <TextView
                                android:id="@+id/login_id_tv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="10dp"
                                android:text="P1234"
                                android:fontFamily="@font/noto_sans_kr_regular"
                                android:textColor="@color/secondary_text"
                                android:textSize="15sp"
                                android:includeFontPadding="false"
                                app:layout_constraintTop_toBottomOf="@id/login_id_title_tv"
                                app:layout_constraintStart_toStartOf="@id/login_id_title_tv"
                                app:layout_constraintBottom_toBottomOf="parent"/>

                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <ImageView
                        android:id="@+id/last_login_iv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_marginTop="20dp"
                        android:src="@drawable/ic_password_sv"
                        app:layout_constraintTop_toBottomOf="@id/id_cv"
                        app:layout_constraintStart_toStartOf="@id/id_cv"/>

                    <TextView
                        android:id="@+id/last_login_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="마지막 접속 날짜"
                        android:fontFamily="@font/noto_sans_kr_regular"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:includeFontPadding="false"
                        app:layout_constraintTop_toTopOf="@id/last_login_iv"
                        app:layout_constraintStart_toEndOf="@id/last_login_iv"/>

                    <TextView
                        android:id="@+id/last_login_data_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2025년 11월 20일 13:03:30"
                        android:fontFamily="@font/noto_sans_kr_regular"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:includeFontPadding="false"
                        app:layout_constraintStart_toStartOf="@id/last_login_tv"
                        app:layout_constraintTop_toBottomOf="@id/last_login_tv" />

                    <ImageView
                        android:id="@+id/record_start_date_iv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="30dp"
                        android:src="@drawable/ic_start_date_sv"
                        app:layout_constraintTop_toBottomOf="@id/last_login_iv"
                        app:layout_constraintStart_toStartOf="@id/last_login_iv"/>

                    <TextView
                        android:id="@+id/start_date_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="기록 시작일"
                        android:fontFamily="@font/noto_sans_kr_regular"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:includeFontPadding="false"
                        app:layout_constraintTop_toTopOf="@id/record_start_date_iv"
                        app:layout_constraintStart_toEndOf="@id/record_start_date_iv"/>

                    <TextView
                        android:id="@+id/record_start_date_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2025년 11월 16일"
                        android:fontFamily="@font/noto_sans_kr_regular"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:includeFontPadding="false"
                        app:layout_constraintStart_toStartOf="@id/start_date_tv"
                        app:layout_constraintTop_toBottomOf="@id/start_date_tv" />

                    <TextView
                        android:id="@+id/record_period_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="(D+3)"
                        android:fontFamily="@font/noto_sans_kr_regular"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:includeFontPadding="false"
                        app:layout_constraintStart_toEndOf="@id/record_start_date_tv"
                        app:layout_constraintTop_toTopOf="@id/record_start_date_tv" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/change_password_cv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="10dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="30dp"
                        android:layout_marginEnd="20dp"
                        android:layout_marginBottom="20dp"
                        android:backgroundTint="@color/white"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="0dp"
                        app:layout_constraintTop_toBottomOf="@id/record_period_tv"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:strokeWidth="1dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="12dp"
                            android:background="@color/white">

                            <TextView
                                android:id="@+id/change_password_tv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="15dp"
                                android:layout_marginVertical="6dp"
                                android:fontFamily="@font/noto_sans_kr_regular"
                                android:text="비밀번호 변경하기"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:includeFontPadding="false"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"/>

                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </com.google.android.material.card.MaterialCardView>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/app_info_cv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="20dp"
                android:backgroundTint="@color/white"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/patient_info_cv"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white">

                    <ImageView
                        android:id="@+id/info_iv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginStart="15dp"
                        android:src="@drawable/ic_info_sv"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <TextView
                        android:id="@+id/app_info_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="앱 정보"
                        android:textSize="16sp"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/noto_sans_kr_medium"
                        app:layout_constraintStart_toEndOf="@id/info_iv"
                        app:layout_constraintTop_toTopOf="@id/info_iv"/>

                    <TextView
                        android:id="@+id/version_title_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="40dp"
                        android:layout_marginStart="10dp"
                        android:text="버전"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/noto_sans_kr_regular"
                        app:layout_constraintTop_toBottomOf="@id/info_iv"
                        app:layout_constraintStart_toStartOf="@id/info_iv"/>

                    <TextView
                        android:id="@+id/version_content_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="20dp"
                        android:text="1.0"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/noto_sans_kr_regular"
                        app:layout_constraintTop_toTopOf="@id/version_title_tv"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <ImageView
                        android:id="@+id/horizon_01_iv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        android:layout_marginTop="20dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_horizon_sv"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/version_content_tv"/>

                    <TextView
                        android:id="@+id/agreements_title_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="이용약관"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/noto_sans_kr_regular"
                        app:layout_constraintTop_toBottomOf="@id/horizon_01_iv"
                        app:layout_constraintStart_toStartOf="@id/version_title_tv" />

                    <TextView
                        android:id="@+id/agreements_content_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:text=">"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/noto_sans_kr_regular"
                        app:layout_constraintTop_toTopOf="@id/agreements_title_tv"
                        app:layout_constraintEnd_toEndOf="@id/version_content_tv"/>

                    <ImageView
                        android:id="@+id/horizon_02_iv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        android:layout_marginTop="20dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_horizon_sv"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/agreements_content_tv"/>

                    <TextView
                        android:id="@+id/contact_title_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="고객센터"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/noto_sans_kr_regular"
                        app:layout_constraintTop_toBottomOf="@id/horizon_02_iv"
                        app:layout_constraintStart_toStartOf="@id/agreements_title_tv"/>

                    <TextView
                        android:id="@+id/contact_content_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:layout_marginBottom="30dp"
                        android:text=">"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/noto_sans_kr_regular"
                        app:layout_constraintTop_toTopOf="@id/contact_title_tv"
                        app:layout_constraintEnd_toEndOf="@id/version_content_tv"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/logout_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="19dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="19dp"
                android:layout_marginBottom="20dp"
                android:backgroundTint="@color/white"
                android:fontFamily="@font/noto_sans_kr_regular"
                android:text="로그아웃"
                android:textColor="@color/red"
                android:textSize="15sp"
                app:cornerRadius="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/app_info_cv"
                app:strokeColor="@color/red"
                app:strokeWidth="1dp" />

            <TextView
                android:id="@+id/app_description_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="복막투석 관리 앱"
                android:textColor="@color/secondary_text"
                android:textSize="14sp"
                android:includeFontPadding="false"
                android:fontFamily="@font/noto_sans_kr_regular"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/logout_btn"/>

            <TextView
                android:id="@+id/app_rights_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="© 2025 AIDI. All rights reserved."
                android:textColor="@color/secondary_text"
                android:textSize="14sp"
                android:includeFontPadding="false"
                android:fontFamily="@font/noto_sans_kr_regular"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/app_description_tv"
                app:layout_constraintBottom_toBottomOf="parent"/>


        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>